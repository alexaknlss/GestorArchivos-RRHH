<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

@{
    ViewData["Title"] = "Revisión de Incapacidades";

    var todosLosArchivos = ViewBag.TodosLosArchivos as List<(string Nombre, string Carpeta)>
        ?? new List<(string, string)>();

    var nombreActual = ViewBag.NombreActual as string;
    var carpetaOrigen = ViewBag.CarpetaOrigen as string;
    var carpetaDestino = ViewBag.CarpetaDestino as string;
}

<!-- alerts -->
@if (ViewBag.MensajeExito != null)
{
    <div id="alertExito"
         class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @ViewBag.MensajeExito

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (ViewBag.Error != null)
{
    <div id="alertError"
         class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


<div class="contract">
    @Html.AntiForgeryToken()

         <!--header-->
    <div class="contract-header mb-3">

        <div class="contract-header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>

        <div>
            <h2>Revisión y renombrado de incapacidades</h2>

            <p class="mb-1">
                Selecciona un archivo, visualízalo y asígnale
                un nombre personalizado.
            </p>
        </div>

    </div>


    <!-- form rename-->
    @if (!string.IsNullOrEmpty(nombreActual))
    {
        <div class="card mb-3">

            <div class="card-body py-3">

                <form asp-action="Guardar"
                      method="post">

                    <!-- date -->
                    <input type="hidden"
                           name="nombreOriginal"
                           value="@nombreActual" />

                    <input type="hidden"
                           name="carpetaOrigen"
                           value="@carpetaOrigen" />


                    <div class="row g-3 align-items-end">

                        <!-- new name-->
                        <div class="col-md-8">

                            <label for="nuevoNombre"
                                   class="form-label fw-bold mb-1">

                                <i class="bi bi-pencil me-1"></i>
                                Nuevo nombre

                            </label>

                            <div class="input-group">

                                <input type="text"
                                       id="nuevoNombre"
                                       name="nuevoNombre"
                                       class="form-control"
                                       placeholder="Ej: Juan_Perez_Incapacidad_2026"
                                       value="@ViewBag.NuevoNombre"
                                       required />

                                <span class="input-group-text">
                                    .pdf
                                </span>

                            </div>

                        </div>


                        <!--selected -->
                        <div class="col-md-4">

                            <label for="selectTipo"
                                   class="form-label fw-bold mb-1">

                                <i class="bi bi-tag me-1"></i>
                                Tipo de incapacidad

                            </label>

                            <div class="d-flex gap-2">

                                <select id="selectTipo"
                                        class="form-select"
                                        title="Tipo de incapacidad">
                                    <!-- llamado js -->
                                </select>

                                <button type="button"
                                        id="btnAddTipo"
                                        class="btn btn-outline-success flex-shrink-0"
                                        title="Agregar nuevo tipo">
                                    <i class="bi bi-plus-lg"></i>
                                </button>

                                <button type="button"
                                        id="btnDelTipo"
                                        class="btn btn-outline-danger flex-shrink-0"
                                        title="Eliminar tipo seleccionado">
                                    <i class="bi bi-dash-lg"></i>
                                </button>

                            </div>

                           

                        </div>


                        <!-- url save -->
                        <div class="col-md-10">

                            <label for="carpetaDestino"
                                   class="form-label fw-bold mb-1">

                                <i class="bi bi-folder me-1"></i>
                                Ruta para guardar

                            </label>

                            <input type="text"
                                   id="carpetaDestino"
                                   name="carpetaDestino"
                                   class="form-control"
                                   placeholder="Ruta donde se guardarán los archivos renombrados"
                                   value="@carpetaDestino" />

                        </div>


                        <!-- btn save-->
                        <div class="col-md-2">

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bi bi-check-circle me-1"></i>
                                Guardar

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>
    }


    <!-- content principal -->
    <div class="row g-3">


        <!--list file -->
        <div class="col-md-3">

            <div class="card h-100">

                <!-- Header -->
                <div class="card-header bg-light d-flex justify-content-between align-items-center">

                    <span>
                        <i class="bi bi-list-ul me-1"></i>
                        Archivos pendientes
                    </span>

                    <span class="badge bg-secondary">
                        @todosLosArchivos.Count
                    </span>

                </div>


                <!-- list -->
                <div class="card-body p-0"
                     style="height: 72vh; overflow-y: auto;">

                    @if (todosLosArchivos.Count == 0)
                    {
                        <div class="text-center py-5 px-3">

                            <i class="bi bi-inbox"
                               style="font-size: 2.5rem; color: #c0c0c0;">
                            </i>

                            <p class="text-muted mt-3">
                                No hay archivos pendientes
                                en ninguna carpeta.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">

                            @foreach (var item in todosLosArchivos)
                            {
                                var isActive =
                                    item.Nombre == nombreActual &&
                                    item.Carpeta == carpetaOrigen;

                                <a asp-action="Index"
                                   asp-route-nombreArchivo="@item.Nombre"
                                   asp-route-carpetaOrigen="@item.Carpeta"
                                   class="list-group-item list-group-item-action @(isActive ? "active" : "")">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="text-truncate"
                                             style="min-width: 0;">

                                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i>

                                            <span title="@item.Nombre">
                                                @item.Nombre
                                            </span>

                                        </div>

                                        @if (isActive)
                                        {
                                            <i class="bi bi-check-circle-fill text-white ms-2"></i>
                                        }

                                    </div>


                                    <small class="d-block mt-1
                                        @(isActive ? "text-white-50" : "text-muted")"
                                           style="font-size: 0.7rem;">

                                        <i class="bi bi-folder me-1"></i>

                                        @item.Carpeta

                                    </small>

                                </a>
                            }

                        </div>
                    }

                </div>

            </div>


            <!-- btn drop -->
            @if (todosLosArchivos.Count > 0 &&
                 !string.IsNullOrEmpty(nombreActual))
            {
                <div class="mt-3">

                    <form asp-action="Eliminar"
                          asp-route-nombreArchivo="@nombreActual"
                          asp-route-carpetaOrigen="@carpetaOrigen"
                          method="post"
                          onsubmit="return confirm('¿Eliminar este archivo?');">

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm w-100">

                            <i class="bi bi-trash me-1"></i>
                            Eliminar archivo

                        </button>

                    </form>

                </div>
            }


            <!-- btn clean -->
            <div class="mt-2">

                <form asp-action="LimpiarHistorial"
                      method="post"
                      onsubmit="return confirm('¿Limpiar el historial de carpetas? Esto no eliminará archivos, solo la lista de carpetas revisadas.');">

                    <button type="submit"
                            class="btn btn-outline-secondary btn-sm w-100">

                        <i class="bi bi-eraser me-1"></i>
                        Limpiar historial

                    </button>

                </form>

            </div>

        </div>


        <!-- show pdf -->
        <div class="col-md-9">

            @if (string.IsNullOrEmpty(nombreActual))
            {
               
                <div class="card"
                     style="height: 72vh;">

                    <div class="card-body
                        d-flex
                        flex-column
                        justify-content-center
                        align-items-center
                        text-center">

                        <i class="bi bi-eye-slash"
                           style="font-size: 4rem; color: #c0c0c0;">
                        </i>

                        <h5 class="mt-3 text-muted">
                            Selecciona un archivo para revisar
                        </h5>

                        <p class="text-muted mb-0">
                            Haz clic en un archivo de la lista
                            de la izquierda.
                        </p>

                    </div>

                </div>
            }
            else
            {
                <!-- show pdf -->
                <div class="card"
                     style="height: 72vh;">

                    <!-- Header del visor -->
                    <div class="card-header bg-light
                        d-flex
                        justify-content-between
                        align-items-center">

                        <div class="text-truncate">

                            <i class="bi bi-file-earmark-medical me-1"></i>

                            Revisando:

                            <strong>
                                @nombreActual
                            </strong>

                        </div>


                        <span class="badge bg-secondary ms-2">

                            <i class="bi bi-folder me-1"></i>

                            @carpetaOrigen

                        </span>

                    </div>


                    <!-- Contenido: iframe PDF -->
                    <div class="card-body p-0"
                         style="height: calc(72vh - 57px);">

                        <iframe src="@Url.Action(
   "VerPdf",
  new
   {
    nombreArchivo = nombreActual,
    carpetaOrigen = carpetaOrigen
     })"
                                style="width:100%;
                            height:100%;
                            border:none;"
                                frameborder="0">

                            Tu navegador no soporta
                            la visualización de PDF.

                        </iframe>

                    </div>

                </div>
            }

        </div>

    </div>

</div>



<!-- scripts-->
@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

     
        // Auto alerts
        

        document.addEventListener('DOMContentLoaded', function () {

            const alertas = document.querySelectorAll('.alert');

            alertas.forEach(function (alerta) {

                if (
                    alerta.classList.contains('alert-success') ||
                    alerta.classList.contains('alert-danger')
                ) {

                    setTimeout(function () {

                        alerta.classList.remove('show');
                        alerta.classList.add('fade');

                        setTimeout(function () {

                            if (alerta.parentNode) {
                                alerta.remove();
                            }

                        }, 300);

                    }, 5000);

                }

            });

        });


        // Focus al input de nuevo nombre

        document.addEventListener('DOMContentLoaded', function () {

            const input = document.getElementById('nuevoNombre');

            if (input) {
                input.focus();
                input.select();
            }

        });


        // Select de tipos de incapacidad + SweetAlert

        (function () {

            const input  = document.getElementById('nuevoNombre');
            const select = document.getElementById('selectTipo');
            const btnAdd = document.getElementById('btnAddTipo');
            const btnDel = document.getElementById('btnDelTipo');

            if (!input || !select || !btnAdd || !btnDel) return;

            // Anti-forgery viene del token suelto en el div.contract
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            let tiposCache = [];

            // carge type

            async function cargarTipos() {
                try {
                    const res  = await fetch('@Url.Action("ListarTiposAjax")');
                    tiposCache = await res.json();
                    pintarSelect(tiposCache);
                    detectarTipoEnNombre();
                } catch (e) {
                    console.error('Error cargando tipos', e);
                }
            }

            function pintarSelect(tipos) {
                select.innerHTML = '';

                const optVacia = document.createElement('option');
                optVacia.value = '';
                optVacia.textContent = '— Sin tipo —';
                select.appendChild(optVacia);

                tipos.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.valor;
                    opt.textContent = t.texto;
                    select.appendChild(opt);
                });
            }

            // type detection in name
            // structure: cualquier-cosa-TIPO-8digitos  (opcional " (N)")

            function detectarTipoEnNombre() {
                const nombre = input.value || '';
                const extension = '.pdf';
                const base = nombre.toLowerCase().endsWith(extension)
                    ? nombre.slice(0, -extension.length)
                    : nombre;

                // Patrón: cualquier-cosa-TIPO-8digitos  (opcional " (N)")
                const match = base.match(/^(.+?)-(.+?)-(\d{8})(\s*\(\d+\))?$/);

                if (!match) {
                    select.value = '';
                    return;
                }

                const tipoEnNombre = match[2].trim();

                const encontrado = tiposCache.find(t =>
                    t.valor.toLowerCase() === tipoEnNombre.toLowerCase()
                );

                select.value = encontrado ? encontrado.valor : '';
            }

            // Reemplaza el segmento del tipo preservando código, fecha y contador.

            function aplicarTipoEnNombre(nuevoValor) {
                let nombre = input.value || '';
                const extension = '.pdf';
                const base = nombre.toLowerCase().endsWith(extension)
                    ? nombre.slice(0, -extension.length)
                    : nombre;

                const match = base.match(/^(.+?)-(.+?)-(\d{8})(\s*\(\d+\))?$/);

                let nuevaBase;

                if (match) {
                    const codigo   = match[1].trim();
                    const fecha    = match[3];
                    const contador = match[4] || '';

                    if (nuevoValor) {
                        nuevaBase = `${codigo}-${nuevoValor}-${fecha}${contador}`;
                    } else {
                        // code date
                        nuevaBase = `${codigo}-${fecha}${contador}`;
                    }
                } else {
                    // Fallback
                    if (nuevoValor) {
                        nuevaBase = `${base}-${nuevoValor}`;
                    } else {
                        nuevaBase = base;
                    }
                }

                input.value = nuevaBase + extension;
                input.dispatchEvent(new Event('input'));
            }

            select.addEventListener('change', () => {
                aplicarTipoEnNombre(select.value);
            });

            input.addEventListener('input', () => {
                detectarTipoEnNombre();
            });

            // add type

            btnAdd.addEventListener('click', async () => {

                const { value: formValues } = await Swal.fire({
                    title: 'Nuevo tipo de incapacidad',
                    html:
                        '<input id="swal-valor" class="swal2-input" ' +
                        'placeholder="Valor (va en el nombre del archivo)">' +
                        '<input id="swal-texto" class="swal2-input" ' +
                        'placeholder="Texto visible (opcional)">',
                    focusConfirm: false,
                    showCancelButton: true,
                    confirmButtonText: 'Agregar',
                    cancelButtonText: 'Cancelar',
                    preConfirm: () => {
                        const valor = document.getElementById('swal-valor').value.trim();
                        const texto = document.getElementById('swal-texto').value.trim();
                        if (!valor) {
                            Swal.showValidationMessage('El valor es obligatorio');
                            return false;
                        }
                        return { valor, texto: texto || valor };
                    }
                });

                if (!formValues) return;

                const res = await fetch('@Url.Action("AgregarTipoAjax")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(formValues)
                });

                const data = await res.json();
                if (!data.ok) {
                    Swal.fire('Error', data.mensaje, 'error');
                    return;
                }

                await cargarTipos();

                select.value = formValues.valor;
                aplicarTipoEnNombre(formValues.valor);

                Swal.fire({
                    icon: 'success',
                    title: 'Listo',
                    text: data.mensaje,
                    timer: 1500,
                    showConfirmButton: false
                });
            });

            // drop type

            btnDel.addEventListener('click', async () => {

                if (tiposCache.length === 0) return;

                const opciones = tiposCache.reduce((acc, t) => {
                    acc[t.valor] = t.texto;
                    return acc;
                }, {});

                const { value: valorSel } = await Swal.fire({
                    title: 'Eliminar tipo',
                    input: 'select',
                    inputOptions: opciones,
                    inputPlaceholder: 'Selecciona un tipo',
                    showCancelButton: true,
                    confirmButtonText: 'Eliminar',
                    confirmButtonColor: '#d33',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (v) => !v ? 'Debes seleccionar un tipo' : null
                });

                if (!valorSel) return;

                const res = await fetch('@Url.Action("EliminarTipoAjax")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ valor: valorSel })
                });

                const data = await res.json();
                if (!data.ok) {
                    Swal.fire('Error', data.mensaje, 'error');
                    return;
                }

                await cargarTipos();

                Swal.fire({
                    icon: 'success',
                    title: 'Listo',
                    text: data.mensaje,
                    timer: 1500,
                    showConfirmButton: false
                });
            });

            // -------- Init --------

            document.addEventListener('DOMContentLoaded', cargarTipos);

        })();

    </script>
}