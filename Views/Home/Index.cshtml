@{
    ViewData["Title"] = "Personas y Cultura";
}

<div id="principal" class="py-1">
    <div class="container">

        <!-- Header -->
        <div class="text-center mb-4">
            <h1 class="display-4 fw-bold" style="color: #145c42;">
                <i class="bi bi-people-fill me-2"></i>Personas y Cultura
            </h1>
            <p class="lead text-muted">
                Construyendo un entorno donde cada persona crece, colabora y transforma.
            </p>
            <hr class="w-25 mx-auto" style="border-color: #E89F4A;">
        </div>

        <!-- Carrusel -->
        <div id="carouselPersonasCultura"   
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="2000">
            <!-- new in 2 seconds -->
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carouselPersonasCultura" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#carouselPersonasCultura" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#carouselPersonasCultura" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner rounded-4 shadow-lg">

                <!-- Images 1 -->
                <div class="carousel-item active">
                    <img src="~/Images/puros3.jpg"
                         class="d-block w-100"
                         alt="Equipo colaborando"
                         style="height: 500px; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3>Colaboración</h3>
                        <p>Trabajamos juntos para lograr grandes resultados.</p>
                    </div>
                </div>

                <!-- Images 2 -->
                <div class="carousel-item">
                    <img src="~/Images/Puros2.jpeg"
                         class="d-block w-100"
                         alt="Diversidad e inclusión"
                         style="height: 500px; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3>Diversidad e Inclusión</h3>
                        <p>Cada persona aporta su valor único a nuestra cultura.</p>
                    </div>
                </div>

                <!-- Images 3 -->
                <div class="carousel-item">
                    <img src="~/Images/Puros1.jpeg"
                         class="d-block w-100"
                         alt="Crecimiento personal"
                         style="height: 60vh; object-fit: cover; width: 100%;">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3>Crecimiento y Desarrollo</h3>
                        <p>Invertimos en el talento y el futuro de nuestra gente.</p>
                    </div>
                </div>

            </div>

            <!-- Controllers -->
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselPersonasCultura" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselPersonasCultura" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>

        <!-- Message aditional -->
        <div class="row mt-5 g-4 text-center">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 shadow-sm">
                    <i class="bi bi-heart-fill fs-1" style="color: #145c42;"></i>
                    <h5 class="mt-2">Valores compartidos</h5>
                    <p class="text-muted">Ética, respeto y transparencia guían cada decisión.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 shadow-sm">
                    <i class="bi bi-people-fill fs-1" style="color: #145c42;"></i>
                    <h5 class="mt-2">Equipo unido</h5>
                    <p class="text-muted">Fomentamos un ambiente de confianza y apoyo mutuo.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 shadow-sm">
                    <i class="bi bi-graph-up-arrow fs-1" style="color: #145c42;"></i>
                    <h5 class="mt-2">Innovación constante</h5>
                    <p class="text-muted">Impulsamos el cambio con creatividad y aprendizaje.</p>
                </div>
            </div>
        </div>

    </div>
</div>