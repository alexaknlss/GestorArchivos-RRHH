@{
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Personas y Cultura</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="topbar">

        <div class="brand">

            <div class="brand-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <h1>Personas y Cultura</h1>
                <span>DIGITALIZACIÓN</span>
            </div>

        </div>


       

    </header>


    <div class="app-container">

        <aside class="sidebar">

            <nav class="sidebar-menu">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="menu-item  @(Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/Home") ? "active" : "")">

                    <i class="bi bi-house-door"></i>
                    <span>Inicio</span>

                </a>

                <a asp-controller="Contrato"
                   asp-action="Index"
                   class="menu-item @(Context.Request.Path.StartsWithSegments("/Contrato") ? "active" : "")">

                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span>Contrato</span>

               </a>

               <a asp-controller="Finiquito"
                  asp-action="Index"
                  class="menu-item @(Context.Request.Path.StartsWithSegments("/Finiquito") ? "active" : "")">

                   <i class="bi bi-file-earmark-check"></i>
                   <span>Finiquitos</span>

               </a>

               <a asp-controller="Incapacidad"
                  asp-action="Index"
                  class="menu-item @(Context.Request.Path.StartsWithSegments("/Incapacidad") ? "active" : "")">

                    <i class="bi bi-file-earmark-medical"></i>
                    <span>Incapacidades</span>

              </a>

            </nav>


            <div class="sidebar-bottom">

                <a href="#"
                   class="menu-item">

                    <i class="bi bi-box-arrow-right"></i>
                    <span>Cerrar sesión</span>

                </a>

            </div>

        </aside>


        <main class="main-content">

            @RenderBody()

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>