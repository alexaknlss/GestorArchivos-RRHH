@{
    ViewData["Title"] = "Finiquitos";

    var archivosGenerados =
        ViewBag.ArchivosGenerados as List<string>;
}


@if (ViewBag.MensajeExito != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill me-2"></i>
        @ViewBag.MensajeExito
    </div>
}


@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
    </div>
}


<div class="finiquito-page">

    <!-- ENCABEZADO -->

    <div class="finiquito-header">

        <div class="finiquito-header-icon">
            <i class="bi bi-file-earmark-check-fill"></i>
        </div>

        <div>
            <h2>Gestión de finiquitos</h2>

            <p>
                Carga el archivo PDF generado por el escáner
                para separar los finiquitos individuales.
            </p>
        </div>

    </div>


    <!-- FORMULARIO -->

    <form asp-controller="Finiquito"
          asp-action="Procesar"
          method="post"
          enctype="multipart/form-data"
          id="formFiniquito">

        <div class="finiquito-upload-card">

            <div class="upload-icon">
                <i class="bi bi-cloud-arrow-up"></i>
            </div>

            <h3>Subir archivo PDF</h3>

            <p>
                Selecciona el archivo PDF que contiene
                los documentos de finiquito escaneados.
            </p>


            <input type="file"
                   id="pdfFiniquito"
                   name="pdfFiniquito"
                   accept=".pdf,application/pdf"
                   hidden />


            <button type="button"
                    class="btn-select-pdf"
                    onclick="document.getElementById('pdfFiniquito').click()">

                <i class="bi bi-folder2-open"></i>
                Seleccionar PDF

            </button>


            <div id="archivoSeleccionadoFiniquito"
                 class="selected-file">

                <span class="selected-file-name">
                    Ningún archivo seleccionado
                </span>

                <button type="button"
                        id="btnQuitarFiniquito"
                        class="btn-remove-file"
                        title="Quitar archivo"
                        style="display: none;">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <div class="finiquito-process-actions">

                <button type="submit"
                        id="btnProcesarFiniquito"
                        class="btn-process-pdf"
                        disabled>

                    <i class="bi bi-scissors"></i>
                    Procesar finiquitos

                </button>

            </div>


            <div class="finiquito-info">

                <i class="bi bi-info-circle"></i>

                <span>
                    Cada grupo de 3 páginas será generado
                    como un finiquito PDF individual.
                </span>

            </div>

        </div>

    </form>


    <!-- RESULTADOS -->
    @if (archivosGenerados != null &&
             archivosGenerados.Count > 0)
    {
        <div class="finiquito-results">

            <div class="finiquito-results-header">

                <div>

                    <h3>
                        <i class="bi bi-check-circle-fill"></i>
                        Finiquitos generados
                    </h3>

                    <p>
                        Se generaron
                        <strong>@archivosGenerados.Count</strong>
                        archivos PDF correctamente.
                    </p>

                </div>

            </div>


            <div class="finiquito-file-list">

                @foreach (var archivo in archivosGenerados)
                {
                    <div class="finiquito-file-item">

                        <div class="finiquito-file-info">

                            <div class="finiquito-file-icon">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </div>

                            <div>

                                <strong>
                                    @archivo
                                </strong>

                                <span>
                                    Documento PDF generado
                                </span>

                            </div>

                        </div>


                        <div class="finiquito-file-status">

                            <i class="bi bi-check-circle-fill"></i>
                            Listo

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>


@section Scripts
{
    <script>

        const pdfInput =
            document.getElementById(
                "pdfFiniquito"
            );

        const archivoSeleccionado =
            document.getElementById(
                "archivoSeleccionadoFiniquito"
            );

        const nombreArchivo =
            archivoSeleccionado.querySelector(
                ".selected-file-name"
            );

        const btnQuitar =
            document.getElementById(
                "btnQuitarFiniquito"
            );

        const btnProcesar =
            document.getElementById(
                "btnProcesarFiniquito"
            );

        const formFiniquito =
            document.getElementById(
                "formFiniquito"
            );


        // SELECCIONAR PDF

        pdfInput.addEventListener(
            "change",
            function () {

                if (this.files.length === 0) {

                    limpiarArchivo();
                    return;

                }

                const archivo =
                    this.files[0];

                const esPdf =
                    archivo.type === "application/pdf"
                    ||
                    archivo.name
                        .toLowerCase()
                        .endsWith(".pdf");

                if (!esPdf) {

                    alert(
                        "Por favor selecciona un archivo PDF."
                    );

                    limpiarArchivo();
                    return;

                }

                nombreArchivo.textContent =
                    archivo.name;

                btnQuitar.style.display =
                    "flex";

                btnProcesar.disabled =
                    false;

            }
        );


        // QUITAR ARCHIVO

        btnQuitar.addEventListener(
            "click",
            function () {

                limpiarArchivo();

            }
        );


        // PROCESAR

        formFiniquito.addEventListener(
            "submit",
            function () {

                if (pdfInput.files.length === 0) {

                    alert(
                        "Debes seleccionar un archivo PDF."
                    );

                    return false;

                }

                btnProcesar.disabled =
                    true;

                btnProcesar.innerHTML =
                    `
                        <span
                            class="spinner-border spinner-border-sm"
                            aria-hidden="true">
                        </span>

                        Procesando...
                    `;

            }
        );


        // LIMPIAR

        function limpiarArchivo() {

            pdfInput.value =
                "";

            nombreArchivo.textContent =
                "Ningún archivo seleccionado";

            btnQuitar.style.display =
                "none";

            btnProcesar.disabled =
                true;

            btnProcesar.innerHTML =
                `
                    <i class="bi bi-scissors"></i>
                    Procesar finiquitos
                `;

        }


        // =========================================
        // DESCARGAR AUTOMÁTICAMENTE LOS FINIQUITOS
        // =========================================

        @if (archivosGenerados != null &&
                  archivosGenerados.Count > 0)
        {
                <text>

                        const archivosParaDescargar =
                            @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(
                                            archivosGenerados
                                    )
                            );

                        const urlDescarga =
                            '@Url.Action("Descargar", "Finiquito")';


                        window.addEventListener(
                            "load",
                            function () {

                                archivosParaDescargar.forEach(
                                    function (archivo, indice) {

                                        setTimeout(
                                            function () {

                                                const enlace =
                                                    document.createElement(
                                                        "a"
                                                    );

                                                enlace.href =
                                                    urlDescarga
                                                    +
                                                    "?nombreArchivo="
                                                    +
                                                    encodeURIComponent(
                                                        archivo
                                                    );

                                                enlace.download =
                                                    archivo;

                                                enlace.style.display =
                                                    "none";

                                                document.body.appendChild(
                                                    enlace
                                                );

                                                enlace.click();

                                                enlace.remove();

                                            },

                                            indice * 700
                                        );

                                    }
                                );

                            }
                        );

                </text>
        }

    </script>
}