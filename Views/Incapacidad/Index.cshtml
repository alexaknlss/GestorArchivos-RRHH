@section Scripts
{
    <script>
        // Five secunds to hide the alert messages

        document.addEventListener('DOMContentLoaded', function() {
            const alertas = document.querySelectorAll('.alert');

            alertas.forEach(function(alerta) {
                if (alerta.classList.contains('alert-success') ||
                    alerta.classList.contains('alert-danger')) {

                    const tiempoVisualizacion = 5000;

                    setTimeout(function() {
                        alerta.classList.remove('show');
                        alerta.classList.add('fade');

                        setTimeout(function() {
                            if (alerta.parentNode) {
                                alerta.remove();
                            }
                        }, 300);
                    }, tiempoVisualizacion);
                }
            });
        });

        // Elements

        const pdfInput = document.getElementById("pdfIncapacidad");
        const archivoSeleccionado = document.getElementById("archivoSeleccionadoIncapacidad");
        const nombreArchivo = archivoSeleccionado.querySelector(".selected-file-name");
        const btnQuitar = document.getElementById("btnQuitarIncapacidad");

        const excelInput = document.getElementById("archivoExcel");
        const excelSeleccionado = document.getElementById("excelSeleccionado");
        const nombreExcel = excelSeleccionado.querySelector(".selected-excel-name");
        const btnQuitarExcel = document.getElementById("btnQuitarExcel");

        const btnProcesar = document.getElementById("btnProcesarIncapacidad");
        const formIncapacidad = document.getElementById("formIncapacidad");

        // Selected PDF

        pdfInput.addEventListener("change", function() {
            if (this.files.length === 0) {
                limpiarArchivo();
                return;
            }

            const archivo = this.files[0];
            const esPdf = archivo.type === "application/pdf" ||
                archivo.name.toLowerCase().endsWith(".pdf");

            if (!esPdf) {
                alert("Por favor selecciona un archivo PDF.");
                limpiarArchivo();
                return;
            }

            nombreArchivo.textContent = archivo.name;
            btnQuitar.style.display = "flex";
            actualizarEstadoBoton();
        });

        // Selected  Exel

        excelInput.addEventListener("change", function() {
            if (this.files.length === 0) {
                limpiarExcel();
                return;
            }

            const archivo = this.files[0];
            const esExcel = archivo.name.toLowerCase().endsWith(".xlsx");

            if (!esExcel) {
                alert("Por favor selecciona un archivo Excel .xlsx.");
                limpiarExcel();
                return;
            }

            nombreExcel.textContent = archivo.name;
            btnQuitarExcel.style.display = "flex";
            actualizarEstadoBoton();
        });

        // Remove Files

        btnQuitar.addEventListener("click", function() {
            limpiarArchivo();
        });

        btnQuitarExcel.addEventListener("click", function() {
            limpiarExcel();
        });

        // Update Button State

        function actualizarEstadoBoton() {
            const pdfSeleccionado = pdfInput.files.length > 0;
            const excelSeleccionado = excelInput.files.length > 0;
            btnProcesar.disabled = !(pdfSeleccionado && excelSeleccionado);
        }

        // Procesing

        formIncapacidad.addEventListener("submit", function(event) {
            if (pdfInput.files.length === 0) {
                event.preventDefault();
                alert("Debes seleccionar un archivo PDF.");
                return;
            }

            if (excelInput.files.length === 0) {
                event.preventDefault();
                alert("Debes seleccionar un archivo Excel con los códigos.");
                return;
            }

            btnProcesar.disabled = true;
            btnProcesar.innerHTML = `
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        Procesando...
                    `;
        });

        // Clear PDF

        function limpiarArchivo() {
            pdfInput.value = "";
            nombreArchivo.textContent = "Ningún archivo seleccionado";
            btnQuitar.style.display = "none";
            actualizarEstadoBoton();
            restaurarBoton();
        }

        // Clear Exel

        function limpiarExcel() {
            excelInput.value = "";
            nombreExcel.textContent = "Ningún archivo Excel seleccionado";
            btnQuitarExcel.style.display = "none";
            actualizarEstadoBoton();
            restaurarBoton();
        }

        // Restore Button

        function restaurarBoton() {
            btnProcesar.innerHTML = `
                        <i class="bi bi-scissors"></i>
                        Procesar incapacidades
                    `;
        }

        // Open Folder

        function abrirCarpeta(ruta) {
            try {
                const url = 'file:///' + ruta.replace(/\\/g, '/');
                window.open(url, '_blank');
            } catch (e) {
                alert('Abre esta carpeta manualmente:\n' + ruta);
            }
        }

        // Copy url

        function copiarRuta(ruta) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(ruta)
                    .then(() => {
                        mostrarToast(' Ruta copiada al portapapeles');
                    })
                    .catch(() => {
                        fallbackCopiarRuta(ruta);
                    });
            } else {
                fallbackCopiarRuta(ruta);
            }
        }

        function fallbackCopiarRuta(ruta) {
            const input = document.createElement('input');
            input.value = ruta;
            document.body.appendChild(input);
            input.select();
            try {
                document.execCommand('copy');
                mostrarToast(' Ruta copiada al portapapeles');
            } catch (e) {
                alert('Copia manualmente esta ruta:\n' + ruta);
            }
            document.body.removeChild(input);
        }

        function mostrarToast(mensaje) {
            const toast = document.createElement('div');
            toast.className = 'alert alert-success position-fixed top-0 end-0 m-3';
            toast.style.zIndex = '9999';
            toast.style.maxWidth = '400px';
            toast.innerHTML = mensaje;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 3000);
